    "drizzle-orm": "^0.45.1",
    "expo": "^54.0.33",
    "expo-constants": "^18.0.13",
    "expo-font": "^14.0.11",
    "expo-linking": "^8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-system-ui": "~6.0.9",
    "fast-deep-equal": "^3.1.3",
